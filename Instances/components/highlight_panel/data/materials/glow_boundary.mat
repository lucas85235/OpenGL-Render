// A shader that highlights the boundary of a panel.

material {
    name : "HighlightBoundary",
    parameters : [
        // Panel
        {   type : float4,
            name : panelColor,
        },
        {   type : float4,
            name : clickedColor,
        },
        {   type : float2,
            name : panelSize,
        },
        {   type : float2,
            name : minMaxPanelToQuadMargin,
        },

        // Hover / Select
        {   type : float,
            name : controlSelectEffect,
        },
        {   type : float,
            name : changeStateLerp,
        },
        {   type : float2,
            name : cursorPosition,
        },
        // These variable controls the size of the panel
        // Can be used dynamically to control the size of the circle proportionally to the panel
        // or control only the size of the circle without taking into account the proportion
        // To activate the dynamic proportion mode set UseProportionalCircle to 1 and to disable set useProportionalCircle 0
        {   type : float,
            name : proportionalCircleSizeFactor,
        }, // Circle size or dynamic circle size
        {   type : float,
            name : useProportionalCircle,
        }, // 0 == false / 1 == true

        // Corner
        {   type : bool,
            name : isResizable,
        },

        {   type : int,
            name : state,
        },
        {   type : float,
            name : cornerRadius,
        },
        {   type : float,
            name : cornerBoundary,
        },
        {   type : float,
            name : lerpTime,
        },
        {   type : float,
            name : borderAlpha,
        },
        {   type : float2,
            name : minMaxBorderThickness,
        },

        // Click
        {   type : bool,
            name : isClicked,
        }
    ],
    requires : [
        uv0
    ],
    culling : none,
    depthWrite : false,
    blending : transparent,
    shadingModel : unlit,
}

fragment {
#include "glow_boundary.glsl"

    // These match the enum value in HighlightVisual
    const float kStateMove = 1.0;
    const float kStateResizeTopLeft = 2.0;
    const float kStateResizeTopRight = 3.0;
    const float kStateResizeBottomLeft = 4.0;
    const float kStateResizeBottomRight = 5.0;

    float state;
    float isResize;

    float cornerAlphaImpl(vec2 corner) {
        highp float panelProportion = min(materialParams.panelSize.x, materialParams.panelSize.y);
        highp float circle_radius = materialParams.cornerBoundary * panelProportion * 1.5;
        vec2 uv = getUV0();

        vec2 frag_coord = uv * materialParams.panelSize;
        float dist_to_center = distance(frag_coord, corner * materialParams.panelSize);
        float corner_alpha = (1.0 - dist_to_center / circle_radius) * 2.0f;

        return step(dist_to_center, circle_radius) * corner_alpha;
    }

    float cornerAlpha() {
        float stateAlpha = step(kStateResizeTopLeft, state) * step(state, kStateResizeBottomRight + 1.0);
        float resizableAlpha = step(1.0, state) * (1.0 - isResize);
        float alpha = mix(0.0, 1.0, resizableAlpha + stateAlpha - stateAlpha * resizableAlpha);

        vec2 corner;
        corner.x = step(1.0, mod(state - kStateResizeTopLeft, 2.0));
        corner.y = step(3.0, floor(state - kStateResizeTopLeft / 2.0));

        return alpha * cornerAlphaImpl(corner);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // Type casting
        state = float(materialParams.state);
        isResize = materialParams.isResizable ? 1.0 : 0.0;

        float alpha_mask =
                mix(cornerAlpha(), 1.0, float(materialParams.state == 1));

        bool isClicked = materialParams.isClicked;
        vec2 uv = getUV0() * vec2(1, -1) + vec2(-0.5, 0.5);
        vec2 fragmentWorldCoord = uv * materialParams.panelSize;
        float panelSizeAspect = materialParams.panelSize.x / materialParams.panelSize.y;
        vec2 mirroredWorldCoord = abs(fragmentWorldCoord);
        float cornerRadius = materialParams.cornerRadius;
        float lerp = mix(0.0, materialParams.lerpTime, float(materialParams.isResizable));
        highp float animationTime = lerp;
        animationTime = mix(1.0, 0.0, animationTime);
        float animationSwitchTime = 0.7;

        float animationControl = inverseLerp(animationTime, animationSwitchTime, 1.0);
        float maxLineSize = mix(0.0, 0.2, float(materialParams.state > 1) * float(materialParams.isResizable));
        float lineTime = mix(animationControl, clamp(animationControl, 0.0, maxLineSize), float(materialParams.state > 1) * float(materialParams.isResizable));

        vec2 thicknessRange = materialParams.minMaxBorderThickness;
        float maxLineThickness = (thicknessRange.y) * lerp;
        maxLineThickness = clamp(maxLineThickness, thicknessRange.x, 1.0);
        float arcTime = inverseLerp(animationTime, 0.0, animationSwitchTime);
        arcTime = clamp(arcTime, 0.5, 1.0);
        float panelToQuadMargin = mix(
                materialParams.minMaxPanelToQuadMargin.y * materialParams.panelSize.y,
                materialParams.minMaxPanelToQuadMargin.x * materialParams.panelSize.x,
                animationTime);
        vec2 panelSize = materialParams.panelSize - (vec2(panelToQuadMargin, panelToQuadMargin) * 2.0);

        // corner clicked
        float borderThickness = mix(mix(maxLineThickness, thicknessRange.x, animationTime), thicknessRange.y * 0.75,
            float(state != kStateMove) * float(materialParams.isResizable) * float(isClicked));

        float roundedCornerBorderMask = roundedCornerRectBorderMask(mirroredWorldCoord, panelSize * 0.995, cornerRadius, borderThickness * 0.90, lineTime, arcTime) * -1.0;
        float rounderCornerFillMask = roundedBoxSDF(fragmentWorldCoord, panelSize * 0.5 - cornerRadius, cornerRadius * 0.95) * -1.0;
        vec4 fragColor = vec4(0.0);
        vec4 borderColor = vec4(0.0);

        vec4 colorControl = mix(
                vec4(materialParams.panelColor.rgb * materialParams.panelColor.a, materialParams.panelColor.a),
                vec4(materialParams.clickedColor.rgb * materialParams.clickedColor.a, materialParams.clickedColor.a),
                clamp(materialParams.changeStateLerp, 0.0, 1.0));

        fragColor = mix(vec4(0.0), colorControl, float(rounderCornerFillMask > 0.0));

        vec4 panelColorControl = vec4(materialParams.panelColor.rgb * materialParams.panelColor.a, materialParams.borderAlpha);
        vec4 clickedColorControl = vec4(materialParams.clickedColor.rgb * materialParams.clickedColor.a, materialParams.borderAlpha);
        borderColor = mix(vec4(0.0), panelColorControl, float(roundedCornerBorderMask > 0.0));

        float panelAlpha = mix(materialParams.panelColor.a * alpha_mask, 0.0, lerp);
        float circleFactor = mix(1.0f, min(materialParams.panelSize.x, materialParams.panelSize.y), materialParams.useProportionalCircle);
        float circleRadius =  circleFactor * materialParams.proportionalCircleSizeFactor;

        // Apply highlight to panel area
        vec4 panel = fragColor * panelAlpha;
        borderColor = borderColor * alpha_mask;
        vec4 highlight = hoverAndSelectPanelMask(
                fragmentWorldCoord,
                panel,
                borderColor,
                materialParams.cursorPosition,
                state == kStateMove && isClicked,
                lerp,
                materialParams.controlSelectEffect,
                materialParams.changeStateLerp,
                circleRadius);

        material.baseColor = highlight;
    }
}