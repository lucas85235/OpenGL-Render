// A screen space shader.
material {
    name : "Quad",
    parameters : [
        {
            type : {SAMPLER_EXTERNAL},
            name : BaseColor,
        }
    ],
    requires : [
        uv0
    ],
    culling : none,
    depthWrite : false,
    blending : transparent,
    shadingModel : unlit,
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = getUV0();
        if (!gl_FrontFacing) {
           uv.x = 1.0 - uv.x;
        }

        // Assume alpha is not pre-multiplied into RGB. This is necessary to
        // correctly apply inverse tonemapping to the input sRGB texture values.
        vec4 srgb_color = texture(materialParams_BaseColor, uv);
        material.baseColor = vec4(
            inverseTonemapSRGB(srgb_color.rgb) * srgb_color.a, srgb_color.a);
    }
}
