material {
    parameters :
    [
        { type : sampler2d, name : BaseTexture }
    ],
    requires :
    [
        uv0
    ],
    name : "MT_BonfireSprite",
    blending : transparent,
    shadingModel : unlit,
    depthWrite: false,
}

fragment
{
    void material(inout MaterialInputs material)
    {
        prepareMaterial(material);

        vec4 base_color = texture(materialParams_BaseTexture, getUV0());
        base_color.rgb *= base_color.a;
        material.baseColor = base_color;
    }
}
